{
  "theme": "dark",
  "autoCompactThreshold": 50,
  "ignorePatterns": [
    "front/**",
    "**/node_modules/**",
    "**/target/**",
    "**/.expo/**",
    "**/.git/**",
    "**/.venv/**",
    "**/dist/**",
    "**/build/**"
  ],
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "FileEdit(front/**)",
      "FileDelete(front/**)"
    ]
  }
}
