# URL del backend. Obligatoria en builds release (en desarrollo hay un valor por defecto).
# Con http:// el APK habilita tráfico sin cifrar (solo pruebas en red local); en producción usar https://.
EXPO_PUBLIC_API_URL=http://192.168.1.7:8080
# Opcional: WebSocket si no es <API>/ws
# EXPO_PUBLIC_WS_URL=ws://192.168.1.7:8080/ws
# Opcional: servidor TURN para llamadas fuera de la red local
# EXPO_PUBLIC_TURN_URL=
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
