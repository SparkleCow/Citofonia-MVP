{
  "expo": {
    "name": "Citofonía Fácil",
    "slug": "citofonia-facil",
    "scheme": "citofonia-facil",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sparklecow.citofonia"
    },
    "android": {
      "package": "com.sparklecow.citofonia",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#090d24"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Citofonía Fácil usa el micrófono para las llamadas del citófono."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Citofonía Fácil adjunta fotos de los paquetes recibidos en portería.",
          "cameraPermission": "Citofonía Fácil usa la cámara para fotografiar los paquetes recibidos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f4de0"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Citofonía Fácil usa la cámara para escanear el código QR de las visitas autorizadas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "./plugins/withCleartextTraffic",
      "./plugins/withWebrtcProguard"
    ],
    "icon": "./assets/images/icon.png"
  }
}
